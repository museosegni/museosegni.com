# Variabili per il deploy di produzione sul VPS (docker-compose.prod.yml).
# Copiare in .env.prod (NON committare .env.prod, contiene segreti) e compilare.

POSTGRES_PASSWORD=CHANGE_ME

# Il container cms si collega a postgres via rete Docker interna (nome servizio
# "postgres"), non serve esporre la porta 5432 sul VPS.
DATABASE_URL=postgres://museosegni:CHANGE_ME@postgres:5432/museosegni_cms

PAYLOAD_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING

# Lasciare vuota: niente Vercel Blob sul VPS, i media vanno sul volume Docker
# "media" (vedi Dockerfile e collections/Media.ts).
BLOB_READ_WRITE_TOKEN=
