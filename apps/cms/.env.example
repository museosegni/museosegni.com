# Locale: Postgres via docker-compose (vedi docker-compose.yml)
# Su Vercel: lasciare vuota, viene impostata automaticamente collegando
# l'integrazione Postgres (Neon) dal marketplace (Storage -> Postgres),
# oppure impostarla a mano se si usa un Postgres esterno (Neon/Supabase).
DATABASE_URL=postgres://museosegni:password@127.0.0.1:5432/museosegni_cms

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Su Vercel: creare uno store da Storage -> Blob nel dashboard del progetto,
# il token viene aggiunto automaticamente alle env var del progetto.
# In locale si può lasciare vuota: gli upload finiscono nella cartella
# apps/cms/media/ (vedi collections/Media.ts).
BLOB_READ_WRITE_TOKEN=
